BEGIN_PROLOG

# keep all interactions that are in the active volume
icarus_FilterNeutrinoActive: {

  module_type:              "FilterNeutrinosActiveVolume"
  inActive: true
  
} # icarus_FilterNeutrinoActive

# keep only electron (anti)neutrino interactions in the active volume
icarus_FilterNueActive: {
  @table::icarus_FilterNeutrinoActive
  neutrinoPDG: [ 12, -12 ]
} # icarus_FilterNueActive

END_PROLOG
