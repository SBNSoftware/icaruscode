mcsfitproducericarus_raw: {
  module_type: MCSFitProducerICARUS
  inputs: { 
	TRKLabel  : "pandoraTrackICARUS"
	TRKHMLabel: "pandoraTrackICARUS"
	PFPLabel  : "pandoraGausCryo0"
	PFPT0Label: "pandoraGausCryo0"
	CRTT0Label: "CRTT0Tagging"
	rangeLabel: "rangeproducerCryo0:muon"
	caloLabel : "caloskimCalorimetryCryo0" }
  fitter: {
  	pIdHypothesis: 13
	minNumAngles: 5
	minNumSegments: 7
	segmentLength: 14.0
