	minHits: 10
	minLength: 100.0
	eLossMode: 2
	pMin: 100.
	pMax: 1500.
	pStep: 20.
	cutMode: 0
	cutAngles: 0
	dimMode: 2
	planeMode: 3
	fitMode: 0
	removeDeltas: false } }

