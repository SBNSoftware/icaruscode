# File:    stopping_muon_optical_icarus.fcl
# Purpose: Configuration of ICARUSStoppingMuonOpticalAna and its track selector.
# Contact: Matteo Vicenzi (mvicenzi@bnl.gov)
#

#include "icarus_trackcalo_skimmer.fcl"
#include "icarus_ophitfinder.fcl"

BEGIN_PROLOG

# ==============================================================================
# Stopping-track selection
# ===
#
# Cut values are not retyped here: SelectionTool is the same @local:: block
# stage1 uses (icarus_trackcalo_skimmer.fcl) for the calibration ntuples.

stopping_track_selector:
{
  TrackLabels:   [ "pandoraTrackGausCryoE", "pandoraTrackGausCryoW" ]
  PFPLabels:     [ "pandoraGausCryoE",      "pandoraGausCryoW"      ]
  PFPT0Labels:   [ "pandoraGausCryoE",      "pandoraGausCryoW"      ]
  CaloLabels:    [ "calorimetryCryoE",      "calorimetryCryoW"      ]
  FlashLabels:   [ "opflashCryoE",          "opflashCryoW"          ]
  CRTHitT0Label: "CRTT0Tagging"

  AllowShowerLikePFPs:  false
  IncludeCRTHitTagging: true
  IncludeTopCRT:        true
  IncludeSideCRT:       false

  TopCRTDistanceCut_stopping:      [ 100., 100. ]
  TopCRTDistanceCut_throughgoing:  [ 100., 100. ]
  SideCRTDistanceCut_stopping:     [ 100., 100. ]
  SideCRTDistanceCut_throughgoing: [ 100., 100. ]

  # Flash matching: rank on the barycenter distance, veto on the time interval the
  # drift of the track's own hits allows. Same as TPCPMTBarycenterMatchProducer.
  MatchMetric:     "MinRadius"   # or "MinDeltaT"
  UseTimeRange:     true
  TimeRangeMargin:  35.          # us, the production value (tpcpmtbarycentermatch_config.fcl)
  MinFlashPE:       0.
  MaxFlashTrackZ:   300          # cm; 
  RequireFlashMatch: true

  SelectionTool: @local::crthittagged_stopping_selection
}

# ==============================================================================
# === Analyzer
# ===

icarus_stopping_muon_optical:
{
  module_type: ICARUSStoppingMuonOpticalAna

  OpHitLabels:          [ "ophit" ]
  FlashLabels:          [ "opflashCryoE", "opflashCryoW" ]
  OpDetWaveformLabels:  [ "daqPMT" ]
  SaveWaveforms:        true
  OpHitThresholdADC:    0     # ADC
  MCParticleTruthLabel: ""    # keep empty for data
  TriggerLabel:         ""    # keep empty for data
  SimPhotonsLabels:     [ ]   # sequence, not a string; keep empty for data
  # Enables hit-level truth matching, i.e. one truth row per selected track.
  # Left empty (or pointing at a collection that is not in the file) the truth
  # tree falls back to one row per event describing the first primary muon,
  # which is the right answer on a one-particle-per-event gun sample.
  #
  # MUST equal services.BackTrackerService.BackTracker.SimChannelModuleLabel.
  # The matching itself goes through BackTrackerService, which reads its own
  # label and never sees this one; this parameter is only the presence guard
  # that decides whether to attempt matching at all. If the two disagree you get
  # either matching silently switched off (this empty, service fine) or a
  # BackTracker throw on the first hit (this present, service label absent).
  # On the 2D simpledet chain both are "daq:simpleSC"
  # (fcl/reco/Stage1/mc/stage1_run2_icarus_MC_simpledet.fcl:6).
  SimChannelLabel:      ""    # keep empty for data

  SkipUnmatchedEvents: true

  PedAlgoRollingMeanMaker: {   # as icarus_ophitfinder
    tool_type:   "PedAlgoRollingMeanMaker"
    PedAlgoPset: @local::icarus_opreco_pedestal_DocDB24969
  }

  Selector: @local::stopping_track_selector
}

END_PROLOG
