#include "detsim_2d_icarus_refactored_yzsim_overlay.fcl"

physics.producers.daq0.wcls_main.params.YZScaleMapJson: "yzmap_gain_icarus_v4_run4.json"
physics.producers.daq1.wcls_main.params.YZScaleMapJson: "yzmap_gain_icarus_v4_run4.json"
physics.producers.daq2.wcls_main.params.YZScaleMapJson: "yzmap_gain_icarus_v4_run4.json"
physics.producers.daq3.wcls_main.params.YZScaleMapJson: "yzmap_gain_icarus_v4_run4.json"

# Run3/4 optical tune (with no noise)
physics.producers.opdaq: @local::icarus_simpmt_run4_nonoise
physics.producers.opdaq.ApplyTimingDelays:        true
physics.producers.opdaq.UseGainDatabase:          true
physics.producers.opdaq.UseChannelStatusDatabase: true