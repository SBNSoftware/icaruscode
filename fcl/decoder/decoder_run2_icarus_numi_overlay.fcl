#
# File:    decoder_run2_icarus_numi_overlay.fcl
# Purpose: Decoder of the data overlay for NuMI simulation.
# Author:  Gianluca Petrillo (petrillo@slac.stanford.edu)
# Date:    November 18, 2026
#
# This configuration is designed to be run for decoding the data events
# constituting the overlay for simulations on NuMI beam.
# It is pretty identical to the standard one, with the exception that the data
# belonging to a BNB or calibration stream is hacked to look like it belonged
# to a NuMI stream. Then, assuming that the NuMI trigger gate configuration
# from the hardware is correct, these events will propagate the faked stream
# to the rest of the simulation and reconstruction chain.
#
#

#include "decoder_run2_icarus.fcl"

# ... and change the message configuration to a sane one
services.message: @local::icarus_message_services_interactive

physics.producers.daqTrigger.DecoderTool.Decoders[2].ToolConfig.ChangeGateType: [
    { From: 1  To: 2 }, { From: 3  To: 4 }, { From: 5  To: 4 }
]
