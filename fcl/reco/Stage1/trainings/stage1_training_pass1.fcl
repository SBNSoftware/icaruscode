############################################
# Running pass1 DL vertex training
# M Sotgia <msotgia@fnal.gov>
# Nov. 6th 2025
############################################

BEGIN_PROLOG

enable_pandora_vertex_training_pass1: {
    ConfigFile:             "PandoraSettings_Training_DlVertexPass1.xml"
    EnableMCParticles:      true
    DisableRealDataCheck:   true
    UseHitWidths: true
    SimChannelModuleLabel:  "merge"
}

enable_pandora_vertex_training_pass2: {
    ConfigFile:             "PandoraSettings_Training_DlVertexPass2.xml"
    EnableMCParticles:      true
    DisableRealDataCheck:   true
    UseHitWidths: true
    SimChannelModuleLabel:  "merge"
}

END_PROLOG

#include "stage1_run2_icarus_MC.fcl"

physics.producers.pandoraGausCryoE: {
    @table::physics.producers.pandoraGausCryoE
    @table::enable_pandora_vertex_training_pass1
}
physics.producers.pandoraGausCryoW: {
    @table::physics.producers.pandoraGausCryoW
    @table::enable_pandora_vertex_training_pass1
}


physics.reco: [ 
                @sequence::icarus_reco_Gauss2D_CryoE ,
                @sequence::icarus_reco_Gauss2D_CryoW 
              ]

physics.outana: []

services.message: @local::icarus_message_services_interactive_debug
