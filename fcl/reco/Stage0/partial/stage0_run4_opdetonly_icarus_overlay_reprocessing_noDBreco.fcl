## File:    stage0_run4_opdetonly_icarus_overlay_reprocessing_noDBreco.fcl
## Purpose: Reprocessing of the optical products for the SBN2025A "spring" MC OVERLAY production
#           to produce a light variation sample

#include "stage0_run2_wcdnn_icarus_overlay.fcl"

## This job selectively re-runs only the PMT/CRT reconstruction path. 
## This is valid only for the post-processing of the SBN202A production.

## In order to produce a proper variation sample, the optical reconstruction
## needs to stay consistent with the CV. Two consequences:
##
## 1. No use of channel status or gain databases, instead a constant gain
##    is applied for all PMTs.
## 2. Since the re-processed simulation is using a new PE-scale, the constant
##    gain in recostrution needs to scale as well to avoid an artificial
##    mismatch.

process_name: OpMCstage0

## only perform PMT/CRT MCstage0 on top of reprocessed MC overlay files
## Notes:
## - previous MCStage0 PMT/CRT products have already been removed
## - new inputs have been re-baked, but with standard tag names
## - need to pick correct reconstruction tune for PMT flow

# execute PMT/CRT only path
physics.path: [   @sequence::icarus_stage0_overlay_PMT, 
                  @sequence::icarus_stage0_mc_crtreco # only reco, hits from overlay
              ]

physics.producers.ophituncorrected.UseCalibrator: false # no gain DB
physics.producers.ophituncorrected.UseChannelStatusDatabase: false # no channel status DB

# note: SBN2025A CV used local::SPE, we now use the new one
# this folds in the proper treatment for the new PE scale
# old: 256.658 -> now: 131.83 [ADC x tick]
physics.producers.ophituncorrected.SPEArea: @local::SPERun4.Area
physics.producers.ophituncorrected.SPEShift: @local::SPERun4.Shift 

# note: this is now the default, but make clear flash thresholds 
# are also being rescaled w.r.t CV to match new PE-scale:
physics.producers.opflashCryoW.PEThreshold: 200
physics.producers.opflashCryoE.PEThreshold: 200
physics.producers.opflashCryoW.MinPECoinc: 200
physics.producers.opflashCryoE.MinPECoinc: 200
